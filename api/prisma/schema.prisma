generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USER Entity #user

model User {
  id String @id @default(uuid())

  email String @unique
  name String
  username String @unique
  password String 
  avatar String?
  bio String?
  isOnline Boolean @map("is_online") @default(false)
  lastSeen DateTime? @map("last_seen")
  role EnumUserRole @default(USER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // user
  usersSession UserSession[]
  contacts Contact[] @relation("UserContacts")
  addedByUsers Contact[] @relation("UserAsContact")

  // chat
  owners Chat[]
  chatMembers ChatMember[]

  // message
  messages Message[]
  reactions Reaction[]
  comments Comment[]

  // call
  calls Call[] 

  // co_viewing_session
  coViewingSessions CoViewingSession[]

  // report
  reports Report[]
  users BlackList[] @relation("UserBanned")
  admins BlackList[] @relation("AdminWhoBanned")

  @@map("user")
  @@index([username, name])
}

model UserSession {
  id String @id @default(uuid())

  userId String @map("user_id")
  refreshToken String @map("refresh_token")
  userAgent String @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_session")
  @@index([userId])
}

model Contact {
  id String @id @default(uuid())

  ownerId String @map("owner_id")
  contactId String @map("contact_id")
  addedAt DateTime @default(now()) @map("added_at")

  owner User @relation("UserContacts", fields: [ownerId], references: [id], onDelete: Cascade)
  contact User @relation("UserAsContact", fields: [contactId], references: [id], onDelete: Cascade)

  @@map("contact")
  @@unique([ownerId, contactId])
  @@index([ownerId, contactId])
}


// CHAT Entity #chat

model Chat {
  id String @id @default(uuid())

  type EnumChatTypes? @default(GROUP)
  name String
  username String? @unique
  description String?
  avatar String?
  ownerId String @map("owner_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id])

  // message
  messages Message[]

  // call
  calls Call[]

  // chat
  chatMembers ChatMember[]

  // co_viewing_session
  coViewingSessions CoViewingSession[]

  // report
  blackLists BlackList[]

  @@map("chat")
  @@index([name, username])
}

model ChatMember {
  id String @id @default(uuid())

  chatId String @map("chat_id")
  userId String @map("user_id")
  role EnumRoleMember @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")
  lastReadMessageId String?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [lastReadMessageId], references: [id])

  @@map("chat_member")
  @@index([userId])
}

enum EnumUserRole {
  USER
  ADMIN
}

enum EnumChatTypes {
  DIRECT
  GROUP
  CHANNEL
}

enum EnumRoleMember {
  OWNER
  ADMIN
  MEMBER
}

// MESSAGE Entity #message

model Message {
  id String @id @default(uuid())

  userId String @map("user_id")
  chatId String @map("chat_id")
  text String?
  type EnumMessageType @default(TEXT)
  isEdited Boolean? @map("is_edited") @default(false)
  replyToId String? @map("reply_to_id") 

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt() @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  replyTo Message? @relation("ReplyTo", fields: [replyToId], references: [id])

  // chat
  chatMembers ChatMember[]

  // message
  replies Message[] @relation("ReplyTo")
  reactions Reaction[]
  comments Comment[]

  // call
  attachments Attachment[]

  // report
  reports Report[]

  @@map("message")
  @@index([userId, createdAt])
}

model Attachment {
  id String @id @default(uuid())

  messageId String @map("message_id")
  fileUrl String @map("file_url")
  fileName String @map("file_name")
  fileSize Int @map("file_size")
  mimeType EnumMimeType @map("mime_type")

  createdAt DateTime @default(now()) @map("created_at")

  messages Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("attachment")
  @@index([messageId])
}

model Reaction {
  id String @id @default(uuid())

  userId String @map("user_id")
  messageId String @map("message_id")
  emoji String

  user User @relation(fields: [userId], references: [id])
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("reaction")
  @@index([messageId])
}

model Comment {
  id String @id @default(uuid())

  userId String @map("user_id")
  messageId String @map("message_id")
  text String
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt() @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  message Message @relation(fields: [messageId], references: [id])

  @@map("comment")
  @@index([userId])
}

enum EnumMessageType {
  TEXT 
  SYSTEM
  FILE
  CALL_START
}

enum EnumMimeType {
  IMAGE
  PDF
  VIDEO
}

// CALL Entity #call

model Call {
  id String @id @default(uuid())

  chatId String @map("chat_id")
  initiatorId String @map("initiator_id")
  status EnumCallStatus
  type EnumCallType
  startedAt DateTime @default(now())
  endedAt DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  initiator User @relation(fields: [initiatorId], references: [id])

  @@map("call")
  @@index([chatId])
}

model CoViewingSession {
  id String @id @default(uuid())

  chatId String @map("chat_id")
  videoUrl String @map("video_url")
  source EnumCoViewingSessionSource
  currentTime Int 
  status EnumCoViewingSessionStatus
  lastUpdaterId String

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  lastUpdater User @relation(fields: [lastUpdaterId], references: [id])

  @@map("co_viewing_session")
}

enum EnumCallStatus {
  ONGOING
  ENDED
  MISSED
}

enum EnumCallType {
  AUDIO
  VIDEO
}

enum EnumCoViewingSessionStatus {
  PLAY
  PAUSE
}

enum EnumCoViewingSessionSource {
  YOUTUBE
  DIRECT_LINK
  LOCAL
}

// REPORT Entity #report

model Report {
  id String @id @default(uuid())

  reporterId String @map("reporter_id")
  targetId String @map("target_id")
  reason EnumReportReason
  status EnumReportStatus? @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")

  reporter User @relation(fields: [reporterId], references: [id])
  target Message @relation(fields: [targetId], references: [id])

  @@map("report")
}

model BlackList {
  id String @id @default(uuid())

  userId String @map("user_id")
  chatId String? @map("chat_id")
  adminId String @map("admin_id")
  reason EnumBlackListReason
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("UserBanned", fields: [userId], references: [id])
  chat Chat? @relation(fields: [chatId], references: [id])
  admin User @relation("AdminWhoBanned", fields: [adminId], references: [id])

  @@map("black_list")
}

enum EnumReportReason {
  SPAM
  ADULT_CONTENT
  VIOLENCE
  HATE_SPEECH
  OTHER
}

enum EnumReportStatus {
  OPEN
  RESOLVED
}

enum EnumBlackListReason {
  RULES_VIOLENT
  SPAM_BOT
  INAPPROPRIATE_BEHAVIOR
  OTHER
}