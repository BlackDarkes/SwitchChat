{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "useESM": true }]
  },
  "moduleNameMapper": {
    "^@/app/(.*)$": "<rootDir>/../src/$1",
    "^@/modules/(.*)$": "<rootDir>/../src/modules/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
